{
  "schemaVersion": 1,
  "id": "io.github.ieltxua.director",
  "name": "Director",
  "version": "2.1.0-rc.5",
  "author": "Director contributors",
  "license": "0BSD",
  "homepage": "https://github.com/ieltxua/omarchy-director",
  "description": "A theme-native, reversible natural-language director for Hyprland windows and workspaces",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Director.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Director",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "voiceMode": "preview"
    },
    "schema": [
      {
        "key": "voiceMode",
        "type": "string",
        "label": "Right-click voice mode (preview or yolo)"
      }
    ]
  }
}
