#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

command_name="${1:-}"
if [[ $# -gt 0 ]]; then shift; fi

case "$command_name" in
  fast)
    exec ./tests/run
    ;;
  stress)
    case_budget="${DIRECTOR_GENERATED_CASES:-10000}"
    case_seed="${DIRECTOR_GENERATIVE_SEED:-20260919}"
    printf 'Director stress: seed=%s case-budget=%s\n' "$case_seed" "$case_budget" >&2
    exec env DIRECTOR_GENERATED_CASES="$case_budget" PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python3 -m unittest discover -s tests -p 'test_generative.py' -v
    ;;
  semantic)
    exec python3 tests/lab/semantic_eval.py "$@"
    ;;
  semantic-all)
    exec python3 tests/lab/semantic_eval.py --contracts tests/contracts/semantic_extended.json "$@"
    ;;
  api-audit)
    exec python3 tests/lab/capability_audit.py "$@"
    ;;
  live)
    exec python3 tests/lab/e2e_omarchy.py "$@"
    ;;
  *)
    printf '%s\n' \
      'Usage: tests/director-lab fast|stress|semantic|semantic-all|api-audit|live [options]' \
      '' \
      '  fast      deterministic unit and packaging suite' \
      '  stress    seeded high-volume desktop simulation (default 10000 cases)' \
      '  semantic  real Jev contract evaluation; plans only, never executes' \
      '  semantic-all  exhaustive bilingual Jev corpus; plans only, never executes' \
      '  api-audit  compare Director support with the installed Omarchy/Hyprland APIs' \
      '  live      isolated live Omarchy acceptance on reserved workspaces'
    exit 2
    ;;
esac
